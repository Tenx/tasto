# Copy this file to .env before the first start.
# Generate both passwords/secrets; never commit the resulting .env file.
DIRECTUS_SECRET=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-strong-database-password

POSTGRES_DB=directus
POSTGRES_USER=directus

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

DIRECTUS_PORT=8055
PUBLIC_URL=http://localhost:8055
MEDIA_API_PORT=8060
GATEWAY_DB_PASSWORD=replace-with-a-strong-read-only-database-password
MEDIA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://tasto.world,https://www.tasto.world

# Use the real frontend origin in production, without a trailing slash.
# Multiple origins can be comma-separated.
CORS_ORIGIN=http://localhost:3000,https://tasto.world,https://www.tasto.world
